index 00000000..9a5eab90
--- /dev/null
+++ b/packages/py/citry_core/tests/test_attrs_output_key.py
@@ -0,0 +1,72 @@
+"""Native output-cache snapshots retain bounded primitive values and identities."""
+
+import pytest
+
+from citry_core._attrs import output_cache_key
+
+
+@pytest.mark.parametrize(
+    ("values", "admitted"),
+    [
+        ({}, True),
+        ({"name": None, "bool": True, "int": 1, "negative": -3}, True),
+        ({"k": "x" * 2047}, True),
+        ({"k": "x" * 2048}, False),
+        ({str(i): i for i in range(16)}, True),
+        ({str(i): i for i in range(17)}, False),
+        ({"n": (1 << 256) - 1}, True),
+        ({"n": -((1 << 256) - 1)}, True),
+        ({"n": 1 << 256}, False),
+        ({"n": -(1 << 256)}, False),
+        ({"🦊": "\ud800"}, True),
+        ({"\udfff": "🦊" * 2047}, True),
+        ({"\udfff": "🦊" * 2048}, False),
+        ({"value": 1.0}, False),
+        ({"class": ["a"]}, False),
+        ({1: "name"}, False),
+        ([("name", "value")], False),
+    ],
+)
+def test_bounds_and_reference_identity(values, admitted):
+    key = output_cache_key(values)
+    if not admitted:
+        assert key is None
+        return
+    expected = tuple(field for name, value in values.items() for field in (name, type(value), value))
+    assert key == expected
+    assert all(actual is reference for actual, reference in zip(key, expected, strict=True))
+
+
+def test_type_and_order_distinguish_cache_entries():
+    assert output_cache_key({"key": True}) != output_cache_key({"key": 1})
+    assert output_cache_key({"key": False}) != output_cache_key({"key": 0})
+    assert output_cache_key({"a": 1, "b": 2}) != output_cache_key({"b": 2, "a": 1})
+
+
+def test_custom_values_are_rejected_without_protocol_calls():
+    class Text(str):
+        __slots__ = ()
+
+        def __len__(self):
+            raise AssertionError("custom length executed")
+
+    class Number(int):
+        def bit_length(self):
+            raise AssertionError("custom bit length executed")
+
+    class Mapping(dict):
+        def items(self):
+            raise AssertionError("custom iteration executed")
+
+    class Value:
+        def __html__(self):
+            raise AssertionError("custom HTML executed")
+
+        def __str__(self):
+            raise AssertionError("custom string executed")
+
+    assert output_cache_key({Text("key"): "value"}) is None
+    assert output_cache_key({"key": Text("value")}) is None
+    assert output_cache_key({"key": Number(1)}) is None
+    assert output_cache_key(Mapping(key="value")) is None
+    assert output_cache_key({"key": Value()}) is None
