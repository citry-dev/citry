+
+_AttrsOutputKey: TypeAlias = tuple[object, ...]
+
+
+def _python_attrs_output_key(resolved: object) -> _AttrsOutputKey | None:
+    """Snapshot bounded primitive attributes for cores without native key construction."""
+    if type(resolved) is not dict or len(resolved) > 16:
+        return None
+    fields: list[object] = []
+    chars = 0
+    for key, value in resolved.items():
+        if type(key) is not str:
+            return None
+        chars += len(key)
+        kind = type(value)
+        if kind is str:
+            chars += len(value)
+        elif kind is int:
+            if value.bit_length() > 256:
+                return None
+        elif value is not None and kind is not bool:
+            return None
+        if chars > 2048:
+            return None
+        fields.extend((key, kind, value))
+    return tuple(fields)
+
+
+# Capability selection keeps existing core installations importable. Both builders
+# retain the same flat triples, so a miss always formats the key's own snapshot.
+_build_attrs_output_key: Callable[[object], _AttrsOutputKey | None] = getattr(
+    getattr(_rust, "attrs", None), "output_cache_key", _python_attrs_output_key
+)
