/target

# Byte-compiled / optimized / DLL files
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
include/
man/
venv/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

# Django stuff:
*.log
*.sqlite3

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Poetry
# lock file is not needed for development
# as project supports variety of Django versions
poetry.lock

# PyCharm
.idea/

# Python environment
.venv/
.DS_Store
.python-version
site
.direnv/
.envrc

# JS, NPM Dependency directories
node_modules/
jspm_packages/

# Mr Developer
.mr.developer.cfg
.project
.pydevproject

# Rope
.ropeproject

# Ephemeral docs-site CI output dirs (the lighthouse and external-link
# workflows), in case a maintainer runs those build commands locally.
lhsite/
link-check-site/
.lighthouseci/

# Claude Code: per-user local overrides (operating rules and shared
# settings/hooks ARE tracked: CLAUDE.md, AGENTS.md, .claude/settings.json,
# .claude/hooks/).
.claude/settings.local.json
/CLAUDE.local.md

# Local scratch archives of pre-fork reference codebases (kept out of git
# because they are hundreds of MB and are not needed to build anything).
old-*.zip
