{
  "name": "citry-dom-members",
  "version": "0.0.0",
  "private": true,
  "description": "Generates crates/citry_vue_compiler/src/dom_members.rs, the table that tells Citry's Vue server renderer which attribute text a browser keeps for each element and name. Not published.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "generate": "node generate.mjs",
    "check": "node generate.mjs --check",
    "refresh": "node refresh.mjs",
    "test": "node --test test/generator.test.mjs",
    "test:browser": "node --test test/browser.test.mjs"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "8.1.7",
    "@vue/runtime-dom": "3.5.44",
    "@webref/elements": "2.9.2",
    "@webref/idl": "3.86.0",
    "bcd-2023": "npm:@mdn/browser-compat-data@5.3.28",
    "bcd-2025": "npm:@mdn/browser-compat-data@7.1.18",
    "playwright": "1.64.1",
    "webidl2": "24.5.0"
  }
}
