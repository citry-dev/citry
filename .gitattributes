# Line endings in the working tree.
#
# Git otherwise decides this per machine, through `core.autocrlf`. Git for
# Windows turns it on by default, so a Windows checkout rewrites text files to
# CRLF and a test that reads its own input from disk sees different bytes than
# the author committed.
#
# `text eol=lf` pins the working tree to LF on every platform, Windows
# included, rather than only normalizing what goes into the repository.

# Python packages contain checked manifests, generated browser assets, license
# notices, and other byte-frozen release inputs alongside their source. Let Git
# continue to detect binary files, but keep every detected text file in this
# subtree on LF so a Windows checkout verifies the same product bytes.
packages/py/** text=auto eol=lf

# The template formatter's corpus is byte-exact test data. Each case pins the
# formatter's output down to the newline it detected, so translating the input
# on checkout changes the answer the test is checking. CRLF behavior is covered
# separately by the `input_text` cases in index.json, which carry their own
# escapes and are unaffected by checkout.
crates/citry_template_formatter/tests/fixtures/** text eol=lf

# The browser runtimes ship inside the citry wheel and are inlined into rendered
# pages, so their bytes are the product rather than a local working copy. A CRLF
# checkout made the wheel differ by one byte per line, 17475 of them, which is
# what pushed the runtime past its size budget on Windows while the same commit
# passed everywhere else.
packages/py/citry/citry/ext/dependencies/client/*.js text eol=lf
packages/py/citry/citry/ext/events/client/*.js text eol=lf

# Citry UI generates byte-frozen production payloads from readable source
# files, so both inputs and outputs keep the same line endings on every host.
packages/py/citry_ui/citry_ui/components/**/*.source.css text eol=lf
packages/py/citry_ui/citry_ui/components/**/*.source.js text eol=lf
packages/py/citry_ui/citry_ui/components/**/*.min.css text eol=lf
packages/py/citry_ui/citry_ui/components/**/*.min.js text eol=lf

# citry-core's release verifier compares the pure-Python wheel payload with
# the tagged checkout byte for byte. Windows runners otherwise translate these
# package sources to CRLF before Maturin copies them into each wheel.
packages/py/citry_core/citry_core/**/*.py text eol=lf
packages/py/citry_core/citry_core/**/*.pyi text eol=lf
packages/py/citry_core/citry_core/py.typed text eol=lf
packages/py/citry_core/LICENSE text eol=lf
packages/py/citry_core/README.md text eol=lf
packages/py/citry_core/pyproject.toml text eol=lf

# The VS Code extension bundle is generated and minified. JavaScript template
# literals inside it preserve trailing spaces as product bytes, so Git should
# not treat those lines as source-formatting mistakes during release audits.
packages/editors/vscode/out/extension.js text eol=lf whitespace=-blank-at-eol

# This parser research fixture intentionally contains trailing ASCII spaces in
# the `trimmed` message so the spike can measure authored-span preservation.
docs/design/i18n_research/span_parser/fixtures/adversarial.ftl whitespace=-blank-at-eol
