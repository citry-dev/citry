{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": ["ES2022"],
		// TypeScript 7 does not pull in every installed @types package on its
		// own, so the ambient globals this extension uses (setTimeout,
		// AbortController, URLSearchParams) have to be requested by name.
		"types": ["node", "vscode"],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
