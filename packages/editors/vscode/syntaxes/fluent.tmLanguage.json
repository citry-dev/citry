{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Fluent",
	"scopeName": "source.ftl",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#term-definition" },
		{ "include": "#message-definition" },
		{ "include": "#attribute-definition" },
		{ "include": "#string" },
		{ "include": "#variable" },
		{ "include": "#function" },
		{ "include": "#variant" },
		{ "include": "#select" },
		{ "include": "#message-reference" },
		{ "include": "#term-reference" },
		{ "include": "#attribute-reference" },
		{ "include": "#number" },
		{ "include": "#punctuation" }
	],
	"repository": {
		"comment": {
			"match": "^\\s*#{1,3}.*$",
			"name": "comment.line.number-sign.fluent"
		},
		"term-definition": {
			"match": "(?:^\\s*|\\G\\s*)(-)([A-Za-z][A-Za-z0-9_-]*)(\\s*)(=)",
			"name": "meta.definition.term.fluent",
			"captures": {
				"1": { "name": "punctuation.definition.term.fluent" },
				"2": { "name": "entity.name.function.term.fluent" },
				"4": { "name": "keyword.operator.assignment.fluent" }
			}
		},
		"message-definition": {
			"match": "(?:^\\s*|\\G\\s*)([A-Za-z][A-Za-z0-9_-]*)(\\s*)(=)",
			"name": "meta.definition.message.fluent",
			"captures": {
				"1": { "name": "entity.name.label.message.fluent" },
				"3": { "name": "keyword.operator.assignment.fluent" }
			}
		},
		"attribute-definition": {
			"match": "^(\\s+)(\\.)([A-Za-z][A-Za-z0-9_-]*)(\\s*)(=)",
			"name": "meta.definition.attribute.fluent",
			"captures": {
				"2": { "name": "punctuation.definition.attribute.fluent" },
				"3": { "name": "entity.other.attribute-name.fluent" },
				"5": { "name": "keyword.operator.assignment.fluent" }
			}
		},
		"string": {
			"begin": "\"",
			"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fluent" } },
			"end": "\"",
			"endCaptures": { "0": { "name": "punctuation.definition.string.end.fluent" } },
			"name": "string.quoted.double.fluent",
			"patterns": [
				{ "match": "\\\\(?:\\\\|\"|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{6})", "name": "constant.character.escape.fluent" }
			]
		},
		"variable": {
			"match": "(\\$)([A-Za-z][A-Za-z0-9_-]*)",
			"name": "variable.other.fluent",
			"captures": {
				"1": { "name": "punctuation.definition.variable.fluent" },
				"2": { "name": "variable.other.fluent" }
			}
		},
		"function": {
			"match": "\\b[A-Z][A-Z0-9_-]*(?=\\s*\\()",
			"name": "support.function.fluent"
		},
		"variant": {
			"match": "(\\*)?(\\[)([^]\\r\\n]+)(\\])",
			"name": "meta.variant.fluent",
			"captures": {
				"1": { "name": "keyword.operator.default.fluent" },
				"2": { "name": "punctuation.definition.variant.begin.fluent" },
				"3": { "name": "constant.other.variant.fluent" },
				"4": { "name": "punctuation.definition.variant.end.fluent" }
			}
		},
		"select": {
			"match": "->",
			"name": "keyword.operator.select.fluent"
		},
		"message-reference": {
			"match": "(\\{\\s*)([A-Za-z][A-Za-z0-9_-]*)(?=(?:\\.[A-Za-z][A-Za-z0-9_-]*)?\\s*\\})",
			"name": "meta.reference.message.fluent",
			"captures": {
				"1": { "name": "punctuation.section.placeable.begin.fluent" },
				"2": { "name": "variable.other.message.fluent" }
			}
		},
		"term-reference": {
			"match": "(?<![A-Za-z0-9_-])(-)([A-Za-z][A-Za-z0-9_-]*)",
			"name": "variable.other.term.fluent",
			"captures": {
				"1": { "name": "punctuation.definition.term.fluent" },
				"2": { "name": "variable.other.term.fluent" }
			}
		},
		"attribute-reference": {
			"match": "(\\.)([A-Za-z][A-Za-z0-9_-]*)",
			"name": "variable.other.member.fluent",
			"captures": {
				"1": { "name": "punctuation.accessor.fluent" },
				"2": { "name": "variable.other.member.fluent" }
			}
		},
		"number": {
			"match": "(?<![A-Za-z0-9_-])-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?",
			"name": "constant.numeric.fluent"
		},
		"punctuation": {
			"match": "[{}(),:]",
			"name": "punctuation.separator.fluent"
		}
	}
}
