{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  // Biome formats Markdown by default. Keep the README's line wrapping and lists
  // as written; Biome still lints it.
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
