{
  "name": "citry-client",
  "version": "0.0.0",
  "private": true,
  "description": "Build and verification tooling for Citry's committed browser runtimes.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:vue-types": "node build-vue-types.mjs",
    "check:vue-types": "node build-vue-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --test",
    "check": "pnpm run check:vue-types && pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@citry/protocol-events-v1": "workspace:*",
    "@fluent/bundle": "0.19.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
