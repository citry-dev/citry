{
  // Type-checking only: esbuild is the sole emitter (see the build script),
  // so tsc runs with noEmit and never produces output. strict is the point.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,

    // Match the build: esbuild bundles for browsers at es2020.
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "es2021.intl", "dom"],

    // esbuild compiles file-by-file, so every file must stand alone.
    "isolatedModules": true,

    // Runtime packages provide their own types; no ambient @types packages
    // are loaded into this private browser build.
    "types": []
  },
  "include": ["src"]
}
