{
  "ci": {
    "collect": {
      "staticDistDir": "lhsite",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/__quality/citry-ui/orbit-access/index.html",
        "http://localhost/__quality/citry-ui/ledger-dashboard/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "total-byte-weight": ["error", { "maxNumericValue": 409600 }]
      }
    }
  }
}
